{
  "name": "presentkim/kor-string-formatter",
  "description": "Utils for formatting numbers, dates and durations in Korean",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\formatter\\": "src/kim/present/formatter/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\formatter\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
